[Unit]
Description=llm-behavior-ci release service (the active release)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/llm-behavior-ci/release.env
WorkingDirectory=%h
ExecStart=/usr/bin/env bash -c 'exec "$LIFECYCLE_PYTHON" "$LIFECYCLE_RELEASE_ROOT/active/code/scripts/ci/release_ctl.py" serve --release-dir "$LIFECYCLE_RELEASE_ROOT/active"'
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
NoNewPrivileges=true

[Install]
WantedBy=default.target
